{
  "name": "omp-sub-alias",
  "version": "0.1.3",
  "description": "Subscription provider aliases for Oh My Pi / OMP.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "provider",
    "oauth",
    "openai",
    "codex",
    "chatgpt"
  ],
  "license": "MIT",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && bun scripts/bundle-runtime.mjs && rm -rf dist-runtime",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke-host && npm pack --dry-run",
    "prepack": "npm run build && node scripts/prepare-package.mjs",
    "sync-host": "node scripts/sync-host.mjs && bun install",
    "prepare-package": "node scripts/prepare-package.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "smoke-host": "node scripts/smoke-host.mjs"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.14.1",
    "@oh-my-pi/pi-catalog": "18.14.1",
    "@oh-my-pi/pi-coding-agent": "18.14.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.10.0",
    "typescript": "^6.0.2"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashYDirOX/omp-sub-alias.git"
  },
  "homepage": "https://github.com/FlashYDirOX/omp-sub-alias#readme",
  "bugs": {
    "url": "https://github.com/FlashYDirOX/omp-sub-alias/issues"
  }
}
